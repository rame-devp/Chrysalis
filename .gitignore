# MARK LIV — what never belongs in the repository
# Everything below is generated locally or contains secrets and should never be tracked.

# Secrets and credentials
config/api_keys.json
config/certs/
config/whatsapp_web/
**/token*.json
**/client_secret*.json
*credentials*.json
.env
.env.*

# Personal data accumulated by the assistant
memory/long_term.json
memory/*.db

# Python build noise
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Editors and OS junk
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Runtime output and local artifacts
*.log
logs/
downloads/
screenshots/
